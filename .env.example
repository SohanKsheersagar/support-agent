# Local development only; never reuse this password in production.
POSTGRES_PASSWORD=trailhaven_local
DATABASE_URL=postgresql://trailhaven:trailhaven_local@127.0.0.1:5433/trailhaven

# Changing any embedding setting requires rebuilding the KB index.
# The current database schema supports 384-dimensional models.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
EMBEDDING_DOCUMENT_PREFIX=""

# Gemini policy-draft generation (developer CLI; human review required).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
